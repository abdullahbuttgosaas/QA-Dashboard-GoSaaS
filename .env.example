# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key: safe for the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (service-role) key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Gemini — https://aistudio.google.com/apikey (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only accounts on this email domain may sign in.
ALLOWED_EMAIL_DOMAIN=gosaas.ai

# Public base URL (used for auth redirects). Vercel sets VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
